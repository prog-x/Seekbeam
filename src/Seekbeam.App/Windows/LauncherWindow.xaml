<Window x:Class="Seekbeam.App.Windows.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Seekbeam.App.Localization"
        xmlns:c="clr-namespace:Seekbeam.App.Controls"
        Title="Seekbeam" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="720" Background="{DynamicResource BgBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" ShowActivated="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10,12,8">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubFgBrush}" Margin="2,0,10,0" />
                <TextBox x:Name="QueryBox" Grid.Column="1" FontSize="20" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}" VerticalContentAlignment="Center"
                         TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown" AutomationProperties.Name="{l:Tr Launcher_SearchName}" />
                <TextBlock x:Name="Hint" Grid.Column="1" Text="{l:Tr Launcher_Hint}" FontSize="20" IsHitTestVisible="False"
                           Foreground="{DynamicResource SubFgBrush}" VerticalAlignment="Center" Margin="3,0,0,0" />
                <TextBlock x:Name="Busy" Grid.Column="2" Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           VerticalAlignment="Center" Foreground="{DynamicResource SubFgBrush}" Visibility="Collapsed" ToolTip="{l:Tr Launcher_Busy}" />
            </Grid>
            <Grid DockPanel.Dock="Bottom" Margin="4,4,4,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- Shown while names are being indexed: a file not found yet may simply not have been reached. -->
                <Border x:Name="IndexingBanner" Grid.Row="0" Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,0,4"
                        Visibility="Collapsed">
                    <TextBlock x:Name="IndexingBannerText" FontSize="11" Foreground="{DynamicResource SubFgBrush}" TextWrapping="Wrap" />
                </Border>
                <Grid Grid.Row="1">
                <TextBlock x:Name="Status" FontSize="11" Foreground="{DynamicResource SubFgBrush}" />
                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SubFgBrush}"
                           Text="{l:Tr Launcher_Keys}" />
                </Grid>
            </Grid>
            <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" Focusable="False" MaxHeight="560"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     MouseDoubleClick="Results_MouseDoubleClick" PreviewMouseRightButtonUp="Results_RightClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,5" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <c:HighlightTextBlock SourceText="{Binding Name}" Highlights="{Binding Highlights}" FontSize="14.5" TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource FgBrush}" HighlightBrush="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding FuzzyMark}" Margin="6,0,0,0" Foreground="{DynamicResource SubFgBrush}" ToolTip="{l:Tr Launcher_ApproxTip}" />
                                </StackPanel>
                                <TextBlock Text="{Binding SubText}" FontSize="11.5" Foreground="{DynamicResource SubFgBrush}" TextTrimming="CharacterEllipsis" />
                                <!-- Content result: the passage where the words were found. -->
                                <c:HighlightTextBlock SourceText="{Binding Snippet}" Highlights="{Binding SnippetHighlights}" FontSize="11.5" TextWrapping="Wrap"
                                                      MaxHeight="34" Foreground="{DynamicResource FgBrush}" HighlightBrush="{DynamicResource HighlightBrush}" Margin="0,1,0,0">
                                    <c:HighlightTextBlock.Style>
                                        <Style TargetType="c:HighlightTextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSnippet}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:HighlightTextBlock.Style>
                                </c:HighlightTextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubFgBrush}" VerticalAlignment="Center" />
                                <!-- Content-index state: ● indexed · ◌ pending · ○ not indexed · ⚠ failed (shape differs, not only colour). -->
                                <TextBlock Text="{Binding ContentGlyph}" ToolTip="{Binding ContentTip}" FontSize="12" Width="16" TextAlignment="Center"
                                           Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Symbol, Segoe UI"
                                           AutomationProperties.HelpText="{Binding ContentTip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SubFgBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ContentBrushKey}" Value="OkBrush"><Setter Property="Foreground" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ContentBrushKey}" Value="WarnBrush"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding ContentBrushKey}" Value="AccentBrush"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HasContent}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
