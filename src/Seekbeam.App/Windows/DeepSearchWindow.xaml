<Window x:Class="Seekbeam.App.Windows.DeepSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Seekbeam.App.Localization"
        xmlns:c="clr-namespace:Seekbeam.App.Controls"
        Title="{l:Tr Deep_Title}" Width="1180" Height="760" Style="{StaticResource ToolWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" FontSize="17" Padding="6,4" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" KeyDown="QueryBox_KeyDown" TextChanged="QueryBox_TextChanged"
                     ToolTip="{l:Tr Deep_QueryTip}" />
            <Button Grid.Column="1" Content="{l:Tr Deep_SearchButton}" Margin="8,0,0,0" Click="Search_Click" IsDefault="True" />
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:Tr Deep_Scope}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ScopeBox" Width="170" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="{l:Tr Deep_ScopeBoth}" />
                <ComboBoxItem Content="{l:Tr Deep_ScopeContent}" />
                <ComboBoxItem Content="{l:Tr Deep_ScopeNames}" />
            </ComboBox>
            <TextBlock Text="{l:Tr Deep_Types}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <TextBox x:Name="ExtBox" Width="140" ToolTip="{l:Tr Deep_TypesTip}" TextChanged="Filter_Changed" />
            <TextBlock Text="{l:Tr Deep_Location}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox x:Name="LocationBox" Width="260" SelectionChanged="Filter_Changed" />
            <TextBlock Text="{l:Tr Deep_Modified}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox x:Name="DateBox" Width="130" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="{l:Tr Deep_DateAny}" />
                <ComboBoxItem Content="{l:Tr Deep_DateToday}" />
                <ComboBoxItem Content="{l:Tr Deep_Date7}" />
                <ComboBoxItem Content="{l:Tr Deep_Date30}" />
                <ComboBoxItem Content="{l:Tr Deep_DateYear}" />
                <ComboBoxItem Content="{l:Tr Deep_DateOlder}" />
            </ComboBox>
            <TextBlock Text="{l:Tr Deep_Size}" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox x:Name="SizeBox" Width="120" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="{l:Tr Deep_SizeAny}" />
                <ComboBoxItem Content="{l:Tr Deep_SizeSmall}" />
                <ComboBoxItem Content="{l:Tr Deep_SizeMedium}" />
                <ComboBoxItem Content="{l:Tr Deep_SizeLarge}" />
            </ComboBox>
        </WrapPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{DynamicResource SubFgBrush}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Results" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgBrush}" SelectionChanged="Results_SelectionChanged"
                     MouseDoubleClick="Results_MouseDoubleClick" KeyDown="Results_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SubFgBrush}" Margin="8,0,0,0" />
                                    <c:HighlightTextBlock SourceText="{Binding Name}" Highlights="{Binding Highlights}" FontSize="13.5" FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis" HighlightBrush="{DynamicResource AccentBrush}" />
                                </DockPanel>
                                <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="{DynamicResource SubFgBrush}" TextTrimming="CharacterEllipsis" />
                                <c:HighlightTextBlock SourceText="{Binding Snippet}" Highlights="{Binding SnippetHighlights}" FontSize="12" TextWrapping="Wrap"
                                                      MaxHeight="52" Foreground="{DynamicResource FgBrush}" HighlightBrush="{DynamicResource HighlightBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Background="{DynamicResource PanelBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="PreviewTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewInfo" FontSize="11.5" Foreground="{DynamicResource SubFgBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{l:Tr Deep_Open}" Click="Open_Click" />
                            <Button Content="{l:Tr Deep_Folder}" Click="Folder_Click" />
                            <Button Content="{l:Tr Deep_Actions}" Click="Actions_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <c:HighlightTextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5"
                                              HighlightBrush="{DynamicResource HighlightBrush}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
