<Application x:Class="Seekbeam.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Default (light) brushes; replaced at runtime by Theme.Apply -->
        <SolidColorBrush x:Key="BgBrush" Color="White" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F5F6F8" />
        <SolidColorBrush x:Key="FgBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="SubFgBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7DBE0" />
        <SolidColorBrush x:Key="SelBrush" Color="#E3ECFD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B5BDB" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#B45309" />
        <SolidColorBrush x:Key="InputBrush" Color="White" />
        <SolidColorBrush x:Key="OkBrush" Color="#1E8E3E" />
        <SolidColorBrush x:Key="WarnBrush" Color="#C07800" />

        <Style x:Key="ToolWindow" TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Application.Resources>
</Application>
