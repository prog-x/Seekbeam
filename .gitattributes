# Normalize line endings in the repository; Windows tools get CRLF in the working tree.
* text=auto
*.cs      text diff=csharp
*.xaml    text
*.resx    text
*.csproj  text
*.props   text
*.wxs     text
*.ps1     text eol=crlf
*.sln     text eol=crlf
*.md      text
*.yml     text eol=lf
*.ico     binary
*.png     binary
*.msi     binary
*.zip     binary
